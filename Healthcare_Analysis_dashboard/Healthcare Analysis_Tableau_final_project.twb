            <column caption='Age groups' datatype='string' name='[Calculation_1732344351854593]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Age]&lt;20 THEN &quot;under 20&quot;&#13;&#10;ELSEIF [Age]&lt;=30 THEN &quot;21-30&quot;&#13;&#10;ELSEIF [Age]&lt;=40 THEN &quot;31-40&quot;&#13;&#10;ELSEIF [Age]&lt;=50 THEN &quot;41-50&quot;&#13;&#10;ELSEIF [Age]&lt;=60 THEN &quot;51-60&quot;&#13;&#10;ELSE &quot;above 60&quot; end' />
            </column>
            <column caption='payment%' datatype='real' name='[Calculation_1732344354021381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Approved Amount])/SUM([Bill Amount])' />
            </column>
